# Copy to .env for local dev; set as env vars in your hosting platform for prod.

# Backend API base URL. Leave empty in dev (Vite proxies /api to localhost:8000).
# Set in prod, e.g. https://raise-api.onrender.com/api
VITE_API_URL=

# Optional. A link (for example, a survey form) shown as "Give feedback" in the
# prototype banner on every screen. Leave empty to hide it. Must be http(s).
VITE_FEEDBACK_URL=
