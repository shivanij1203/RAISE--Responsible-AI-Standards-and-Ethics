# Copy to .env for local dev; set as env vars in your hosting platform for prod.
# .env is gitignored — never commit real secrets.

# Toggle off in production. Default true (dev).
DJANGO_DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(60))"
# REQUIRED in prod (DEBUG=false). The dev fallback is the django-insecure-* default.
DJANGO_SECRET_KEY=

# Comma-separated list of hostnames the app will accept.
# Example prod: raise.onrender.com,raise.usf.edu
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Local dev: leave DATABASE_URL unset or blank. The backend then
# uses local SQLite at backend_django/db.sqlite3 (run `python manage.py migrate`
# once to create it).
# Never put the Neon/production Postgres URL in your local .env: dev servers,
# seed commands, and tests would all write to it.
# Production only (set in the hosting platform, not here):
#   postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API and send cookies.
# Example prod: https://raise.vercel.app,https://raise.usf.edu
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
